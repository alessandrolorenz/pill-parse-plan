{
  "name": "@pill-parse-plan/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --localhost --android",
    "ios": "expo start --localhost --ios",
    "web": "expo start --localhost --web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@pill-parse-plan/core": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "expo": "~56.0.23",
    "expo-auth-session": "~56.0.0",
    "expo-calendar": "~56.0.0",
    "expo-constants": "~56.0.27",
    "expo-image": "~56.0.0",
    "expo-image-picker": "~56.0.0",
    "expo-linking": "~56.0.0",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.21",
    "expo-splash-screen": "^57.0.10",
    "expo-status-bar": "~56.0.0",
    "expo-web-browser": "~56.0.0",
    "nativewind": "^4.0.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.7",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-jsx": "^7.24.7",
    "@types/react": "^19.1.1",
    "babel-preset-expo": "~56.0.0",
    "tailwindcss": "3.3.2",
    "typescript": "^5.8.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native-svg"
      ]
    }
  }
