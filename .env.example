# ─── Figma Sync ───────────────────────────────────────────────────────────────
# Personal Access Token from https://www.figma.com/settings → "Personal access tokens"
# Required scopes: File content (read), Variables (read)
FIGMA_TOKEN=your_figma_personal_access_token_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...